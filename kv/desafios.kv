<DesafiosScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1
        
        MDTopAppBar:
            title: "Módulo IV: Olimpíadas"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "20dp"
                spacing: "20dp"
                adaptive_height: True

                # --- CARD 1: TEMA E ORIGEM ---
                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    radius: [15]
                    adaptive_height: True
                    md_bg_color: 0.1, 0.5, 0.8, 0.1
                    
                    MDLabel:
                        id: lbl_origem
                        text: "Carregando..."
                        font_style: "Caption"
                        bold: True
                        theme_text_color: "Primary"
                        adaptive_height: True
                    
                    MDLabel:
                        id: lbl_tema
                        text: "Carregando..."
                        font_style: "Subtitle2"
                        theme_text_color: "Secondary"
                        adaptive_height: True

                # --- CARD 2: A PERGUNTA ---
                MDCard:
                    orientation: "vertical"
                    padding: "20dp"
                    radius: [15]
                    adaptive_height: True
                    elevation: 1
                    
                    MDLabel:
                        id: lbl_pergunta
                        text: "Procurando questões no banco de dados..."
                        font_style: "Body1"
                        adaptive_height: True

                # --- ÁREA DINÂMICA: OPÇÕES DE RESPOSTA ---
                MDBoxLayout:
                    id: box_opcoes
                    orientation: 'vertical'
                    spacing: "10dp"
                    adaptive_height: True

                # --- CARD 3: FEEDBACK E DICA DA IA ---
                MDLabel:
                    id: lbl_feedback
                    text: ""
                    halign: "center"
                    adaptive_height: True

                # --- BOTÕES DE AÇÃO ---
                MDBoxLayout:
                    spacing: "10dp"
                    adaptive_height: True
                    
                    MDFillRoundFlatButton:
                        text: "DICA DA TEORIA"
                        icon: "robot-outline"
                        size_hint_x: 0.5
                        md_bg_color: 0.8, 0.5, 0.1, 1
                        on_release: root.mostrar_dica()

                    MDFillRoundFlatButton:
                        text: "PRÓXIMA"
                        icon: "arrow-right"
                        size_hint_x: 0.5
                        md_bg_color: 0.2, 0.6, 0.2, 1
                        on_release: root.proxima_questao()